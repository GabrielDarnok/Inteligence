# Supabase connection (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: API keys for sources that require them
GREYNOISE_API_KEY=
SHADOWSERVER_API_KEY=
SHADOWSERVER_API_SECRET=

# Ingestion settings
LOG_LEVEL=INFO
LOG_FILE=./logs/ingestion.log

# Which connectors to enable (comma-separated, or "all")
ENABLED_CONNECTORS=threatfox,urlhaus,feodo,cisa_kev

# Schedule (cron expression or "manual" to disable scheduler)
SCHEDULE_CRON=0 */6 * * *
